---
// A named photo slot. Drop <slot>.jpg (or .png/.webp) into src/assets/photos/ and it is used,
// resized to AVIF/WebP. Until then: a labelled placeholder in preview; in production a missing
// required slot blocks the build (data-pending) and a missing optional slot renders nothing.
// The slot list doubles as the website shot list (src/assets/photos/README.md).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { PREVIEW } from '../config';

interface Props {
  slot: string;
  alt: string;
  caption: string;
  ratio?: string;
  sizes?: string;
  priority?: boolean;
  required?: boolean;
  class?: string;
}
const { slot, alt, caption, ratio = '4 / 3', sizes = '(min-width: 1160px) 560px, 100vw', priority = false, required = false, class: cls = '' } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const match = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.\w+$/, '') === slot);
const show = match || PREVIEW || required;
---
{match && (
  <Picture
    src={match[1].default}
    alt={alt}
    formats={['avif', 'webp']}
    widths={[480, 800, 1200, 1600]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    class={`photo ${cls}`}
    style={`aspect-ratio: ${ratio}`}
  />
)}
{!match && show && (
  <div class={`photo placeholder ${cls}`} style={`aspect-ratio: ${ratio}`} role="img" aria-label={`Photo to come: ${alt}`} data-pending={required ? `photo:${slot}` : undefined}>
    <svg viewBox="0 0 48 48" width="40" height="40" aria-hidden="true"><path d="M24 5l9 13h-5l8 11h-6l8 11H10l8-11h-6l8-11h-5z" fill="currentColor" /></svg>
    <span class="ph-label">Photo to come</span>
    <span class="ph-caption">{caption}</span>
  </div>
)}

<style>
  .photo { width: 100%; height: auto; object-fit: cover; border-radius: var(--radius); background: var(--cream); }
  .placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 6px;
    padding: 20px;
    text-align: center;
    color: #8a9a80;
    border: 1px solid var(--line);
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, rgba(111, 139, 96, 0.07) 14px 15px),
      linear-gradient(160deg, #f1ead9, #e8dfc9);
  }
  .ph-label { font: 600 0.72rem/1 var(--sans); letter-spacing: 0.12em; text-transform: uppercase; color: var(--moss); }
  .ph-caption { font: 400 0.92rem/1.4 var(--sans); color: var(--ink-soft); max-width: 30ch; }
</style>
