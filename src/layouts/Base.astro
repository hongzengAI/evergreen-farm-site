---
import '../styles/global.css';
import { PREVIEW, GA4_ID, url, nav, tourHref } from '../config';
import { business, place, maxGuests } from '../data/site';
import Fact from '../components/Fact.astro';
import Pending from '../components/Pending.astro';

interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;

const name = business.business.name;
const fullTitle = title === name ? `${name} · Farm weddings and events near ${place.short}` : `${title} · ${name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const here = Astro.url.pathname;
const isCurrent = (href: string) => here === url(href);

// Only facts we can stand behind go into structured data; the address is added once confirmed.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EventVenue',
  name,
  url: new URL(url('/'), Astro.site).href,
  maximumAttendeeCapacity: maxGuests,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(PREVIEW || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#1f3d2b" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {!PREVIEW && <link rel="sitemap" href={url('/sitemap-index.xml')} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>
      // First-touch attribution for the inquiry form (utm_* and external referrer), per session.
      try {
        if (!sessionStorage.getItem('ef_attrib')) {
          var q = new URLSearchParams(location.search), a = { landing_page: location.pathname };
          ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (n) { var v = q.get(n); if (v) a[n] = v.slice(0, 200); });
          if (document.referrer && new URL(document.referrer).host !== location.host) a.referrer = document.referrer.slice(0, 300);
          sessionStorage.setItem('ef_attrib', JSON.stringify(a));
        }
      } catch (e) {}
    </script>
    {GA4_ID && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`}></script>
        <script is:inline define:vars={{ GA4_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', GA4_ID);
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {PREVIEW && (
      <div class="preview-bar" role="note">
        <div class="wrap">
          <strong>Preview · 预览版</strong>
          <span class="long">Draft for owner review. <mark class="pending-mark">Highlighted</mark> items are not confirmed yet, and the site is not taking bookings. 草稿供审阅，黄色标记的内容尚未确认。</span>
          <span class="short"><mark class="pending-mark">Highlighted</mark> = not confirmed · 黄色 = 待确认</span>
        </div>
      </div>
    )}
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={url('/')} aria-label={`${name} home`}>
          <svg viewBox="0 0 48 48" width="34" height="34" aria-hidden="true"><circle cx="24" cy="24" r="23" fill="#1f3d2b" /><path d="M24 9l7.5 11H27l6.5 9.5H28L34 38H14l6-8.5h-5.5L21 20h-4.5z" fill="#f3e3c3" /></svg>
          <span>Evergreen <em>Farm</em></span>
        </a>
        <nav class="nav-desktop" aria-label="Main">
          {nav.map((n) => <a href={url(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <a class="btn nav-cta" href={url('/inquire/')}>Inquire</a>
        </nav>
        <details class="nav-mobile">
          <summary aria-label="Menu"><span></span><span></span><span></span></summary>
          <nav aria-label="Main (mobile)">
            {nav.map((n) => <a href={url(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
            <a href={tourHref}>Book a tour</a>
            <a class="btn" href={url('/inquire/')}>Inquire</a>
          </nav>
        </details>
      </div>
    </header>

    <script>
      // The mobile menu is a <details>; also close it on an outside tap or Escape.
      const menu = document.querySelector<HTMLDetailsElement>('.nav-mobile');
      if (menu) {
        document.addEventListener('click', (e) => { if (menu.open && !menu.contains(e.target as Node)) menu.open = false; });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
        });
      }
    </script>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap cols">
        <div class="about">
          <p class="brand-foot">Evergreen <em>Farm</em></p>
          <p>Farm weddings and celebrations for up to {maxGuests} guests, <Fact id="location.area" inline>near {place.short}</Fact>.</p>
          <p class="small">
            <Fact id="contact.email_only" inline>The best way to reach us is by email.</Fact>{' '}
            {business.business.email
              ? <a href={`mailto:${business.business.email}`}>{business.business.email}</a>
              : <Pending id="business.email" label="Venue email address" inline />}
          </p>
        </div>
        <nav aria-label="Explore">
          <p class="h">Explore</p>
          {nav.slice(0, 5).map((n) => <a href={url(n.href)}>{n.label}</a>)}
        </nav>
        <nav aria-label="Plan">
          <p class="h">Plan</p>
          <a href={url('/availability/')}>Check availability</a>
          <a href={tourHref}>Book a tour</a>
          <a href={url('/inquire/')}>Send an inquiry</a>
        </nav>
        <nav aria-label="Legal">
          <p class="h">Policies</p>
          <a href={url('/privacy/')}>Privacy</a>
          <a href={url('/sms-terms/')}>SMS terms</a>
        </nav>
      </div>
      <div class="wrap legal small">© {new Date().getFullYear()} {name}</div>
    </footer>
  </body>
</html>

<style>
  .skip { position: absolute; left: 12px; top: -60px; z-index: 50; background: var(--evergreen); color: #fff; padding: 10px 14px; border-radius: 8px; }
  .skip:focus { top: 12px; }

  .preview-bar { background: #2a2418; color: #f5ecd9; font-size: 0.86rem; line-height: 1.45; }
  .preview-bar .wrap { display: flex; flex-wrap: wrap; gap: 4px 12px; padding-block: 8px; }
  .preview-bar .pending-mark { color: #2a2418; }
  .preview-bar .short { display: none; }
  @media (max-width: 640px) { .preview-bar .long { display: none; } .preview-bar .short { display: inline; } }

  .site-header { position: sticky; top: 0; z-index: 20; background: rgba(251, 248, 241, 0.92); backdrop-filter: saturate(1.2) blur(10px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 72px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--evergreen); font: 500 1.35rem/1 var(--serif); letter-spacing: -0.01em; }
  .brand em, .brand-foot em { font-style: italic; font-weight: 400; color: var(--wheat); }
  .brand-foot em { color: #dcbd82; }
  .nav-desktop { display: flex; align-items: center; gap: 4px; }
  .nav-desktop a:not(.btn) { padding: 10px 12px; border-radius: 8px; color: var(--ink); text-decoration: none; font-size: 0.97rem; }
  .nav-desktop a:not(.btn):hover { background: var(--cream); }
  .nav-desktop a[aria-current='page'] { color: var(--evergreen); box-shadow: inset 0 -2px 0 var(--wheat); border-radius: 0; }
  .nav-cta { margin-left: 8px; min-height: 42px; padding: 10px 20px; }

  .nav-mobile { display: none; position: relative; }
  .nav-mobile summary { list-style: none; cursor: pointer; display: grid; gap: 5px; padding: 12px 10px; border-radius: 8px; }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile summary span { display: block; width: 22px; height: 2px; background: var(--evergreen); border-radius: 2px; }
  .nav-mobile nav { position: absolute; right: 0; top: calc(100% + 8px); width: min(86vw, 320px); display: grid; gap: 2px; padding: 12px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
  .nav-mobile nav a:not(.btn) { padding: 12px; color: var(--ink); text-decoration: none; border-radius: 8px; }
  .nav-mobile nav a:not(.btn):hover { background: var(--cream); }
  .nav-mobile nav .btn { margin-top: 8px; }

  @media (max-width: 960px) {
    .nav-desktop { display: none; }
    .nav-mobile { display: block; }
  }

  .site-footer { background: #17271d; color: #d9dfd5; padding-top: 56px; font-size: 0.97rem; }
  .site-footer a { color: #f0e3c6; text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; }
  .cols { display: grid; gap: 32px; grid-template-columns: 2fr repeat(3, 1fr); }
  .cols nav { display: grid; align-content: start; gap: 8px; }
  .brand-foot { font: 500 1.5rem/1 var(--serif); color: #fbf8f1; margin-bottom: 14px; }
  .h { font: 600 0.75rem/1 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; color: #a9b9a0; margin-bottom: 6px; }
  .legal { border-top: 1px solid rgba(255, 255, 255, 0.1); margin-top: 40px; padding-block: 20px; color: #a9b9a0; }
  .site-footer :global(.pending-mark) { color: #2a2418; }
  .site-footer :global(.pending-mark-block) { color: #2a2418; }
  @media (max-width: 760px) { .cols { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
</style>
