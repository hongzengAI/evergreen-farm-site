---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Photo from '../components/Photo.astro';
import Pending from '../components/Pending.astro';
import { url } from '../config';
import { PREVIEW } from '../config';

// Slots in display order; captions are the shot list. A real photo with the slot's name replaces
// each placeholder. Production needs at least MIN real photos before the page can launch.
const MIN = 6;
const slots = [
  { slot: 'gallery-landscape', caption: 'Wide view of the farm and ridge at golden hour', alt: 'The farm at golden hour', wide: true },
  { slot: 'ceremony', caption: 'Ceremony site, late-afternoon light, guests seated', alt: 'A ceremony on the farm' },
  { slot: 'reception', caption: 'Reception set for dinner before guests arrive', alt: 'A reception set for dinner' },
  { slot: 'couple-field', caption: 'Couple walking through the field at golden hour', alt: 'A couple walking through the field', tall: true },
  { slot: 'detail-table', caption: 'Table details: linens, flowers, place cards', alt: 'Table setting detail' },
  { slot: 'celebration', caption: 'Birthday party: long tables, guests mid-laugh, string lights', alt: 'Guests at a celebration' },
  { slot: 'residence', caption: 'The Residence from outside, warm evening light', alt: 'The Residence' },
  { slot: 'evening-lights', caption: 'Reception after dark, lights glowing', alt: 'The farm lit up after dark', tall: true },
  { slot: 'getting-ready', caption: 'Getting-ready room, natural window light', alt: 'Getting ready on the wedding day' },
  { slot: 'lawn-games', caption: 'Guests playing lawn games in the afternoon', alt: 'Lawn games on the farm' },
  { slot: 'aerial', caption: 'Drone view of the property and the ridge line', alt: 'The farm from above', wide: true },
];
const real = Object.keys(import.meta.glob('../assets/photos/*.{jpg,jpeg,png,webp}')).map((p) => p.split('/').pop()!.replace(/\.\w+$/, ''));
const count = slots.filter((s) => real.includes(s.slot)).length;
---
<Base title="Gallery" description="Photos of weddings and celebrations at Evergreen Farm: ceremonies, receptions, the Residence and the farm through the seasons.">
  <PageHeader eyebrow="Gallery" title="Moments on the farm">
    <p class="lead">Ceremonies, long dinners and late evenings. Photos are shared with the permission of the couples and hosts who celebrated here.</p>
  </PageHeader>

  <section class="section">
    <div class="wrap">
      {count < MIN && (PREVIEW
        ? <Pending id="gallery.min_photos" label={`${count} of at least ${MIN} photos in place. Needed: photo releases from the two past couples and the birthday-party shoot.`} zh="需要至少 6 张真实照片：两对新人和生日聚会的照片授权" />
        : <span data-pending="gallery.min_photos" hidden></span>)}
      <div class="masonry">
        {slots.map((s) => (
          <div class:list={['tile', { wide: s.wide, tall: s.tall }]}>
            <Photo slot={s.slot} alt={s.alt} caption={s.caption} ratio={s.wide ? '16 / 9' : s.tall ? '3 / 4' : '4 / 3'} sizes="(min-width: 1160px) 380px, (min-width: 640px) 50vw, 100vw" />
          </div>
        ))}
      </div>
      <p class="center more"><a class="btn ghost" href={url('/availability/')}>Check availability</a></p>
    </div>
  </section>
</Base>

<style>
  .masonry { display: grid; gap: clamp(10px, 1.6vw, 18px); grid-template-columns: repeat(3, 1fr); grid-auto-flow: dense; margin-top: 24px; }
  .tile.wide { grid-column: span 2; }
  .tile.tall { grid-row: span 2; }
  .tile :global(.photo) { height: 100%; }
  @media (max-width: 760px) { .masonry { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .masonry { grid-template-columns: 1fr; } .tile.wide { grid-column: auto; } .tile.tall { grid-row: auto; } }
  .more { margin-top: 32px; }
</style>
